<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for n2-logging.

  vault-packages is a private Azure Artifacts feed that holds the N2.* packages. No
  credentials belong in this file: locally use the Azure Artifacts Credential Provider
  (interactive sign-in); in Azure Pipelines the NuGetAuthenticate task supplies them.
  nuget.org is kept for the public packages (Azure.*, Microsoft.*, analyzers).
  N2.* is mapped to both feeds: vault-packages (private builds, pipeline) and nuget.org (GitHub
  workflow, public releases). Everything else comes from nuget.org only.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="vault-packages" value="https://pkgs.dev.azure.com/gjkaal/3b3decf8-eba1-45d0-b47a-d9c1ce84f739/_packaging/vault-packages/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="vault-packages">
      <package pattern="N2.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="N2.*" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

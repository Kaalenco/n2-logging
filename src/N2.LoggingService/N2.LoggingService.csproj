<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>

    <Title>N2-Logging</Title>
    <Company>Kaalenco</Company>
    <Copyright>(c) 2026 - rights reserved</Copyright>
    <Authors>gjkaal</Authors>
    <Description>Process logging to Azure Table Storage with log levels that can be changed at runtime.</Description>
    <PackageReleaseNotes>
      3.0.1 version unification, dependency check (all current).
      3.0.0 use the updated core abstractions and set the version accordingly
      2.1.1 fixes runtime levels never applying (RowKey was missing from the levels query). 
      2.1.0: log retention is ON by default. Rows of this application older than 30 days are purged once every 24 hours. Set N2:TableLogging:RetentionDays to 0 to disable it.</PackageReleaseNotes>
    <IncludeSymbols>False</IncludeSymbols>
    <PackageLicenseExpression>AFL-3.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kaalenco/n2-logging</PackageProjectUrl>
    <PackageId>N2.LoggingService</PackageId>
    <PackageReadmeFile>readme.md</PackageReadmeFile>

    <PackageType>Dependency</PackageType>
    <Product>N2.Core</Product>
    <ProductName>N2 Core libraries</ProductName>
    <Version>3.0.1</Version>
    <PackageVersion>3.0.1</PackageVersion>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.1.0</FileVersion>
    <ProductVersion>3.0.1</ProductVersion>

    <RootNamespace>N2.LoggingService</RootNamespace>
    <NoWarn>
      CS1591,
      CA2007,
      CA1308
    </NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <NuGetAudit>True</NuGetAudit>
    <NuGetAuditMode>All</NuGetAuditMode>
    <NuGetAuditLevel>Low</NuGetAuditLevel>
  </PropertyGroup>

  <!--
    Microsoft.Extensions.* are not part of Microsoft.NETCore.App, so each target references
    the matching major version (same pattern as N2.Core.Abstractions).
  -->
  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="N2.LoggingService.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- TODO bump to 3.0.1 after N2.Core.Abstractions 3.0.1 is published -->
    <PackageReference Include="N2.Core.Abstractions" Version="3.0.0" />
    <PackageReference Include="Azure.Core" Version="1.65.0" />
    <PackageReference Include="Azure.Data.Tables" Version="12.13.0" />

  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeStyle" Version="5.12.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.37.0.15768">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AsyncFixer" Version="2.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
